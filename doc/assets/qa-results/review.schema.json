{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-asset-review.schema.json",
  "title": "SVETS Visual Asset Review Batch",
  "type": "object",
  "required": ["batch_id", "review_date", "reviewer", "reviewer_role", "gate", "assets_reviewed", "results"],
  "properties": {
    "batch_id": { "type": "string", "pattern": "^batch_[a-z0-9_]+$" },
    "review_date": { "type": "string", "format": "date" },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewer_role": { "enum": ["technical", "visual", "vocational", "special_education", "assessment"] },
    "gate": { "type": "integer", "minimum": 1, "maximum": 5 },
    "assets_reviewed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^asset_[a-z0-9_]+$" }
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "notes"],
        "properties": {
          "status": { "enum": ["passed", "rejected", "revision_required"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
