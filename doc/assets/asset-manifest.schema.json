{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-manifest.schema.json",
  "title": "SVETS Asset Manifest",
  "description": "视觉、音频与施测脚本生产、审核及运行时登记合同 v0.5.0",
  "type": "object",
  "required": ["version", "plan_version", "generated_at", "question_authority", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "0.5.0" },
    "plan_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "question_authority": { "$ref": "#/$defs/questionAuthority" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "questionAuthority": {
      "type": "object",
      "required": [
        "job_skill_runtime_authority_path",
        "job_skill_runtime_status",
        "job_skill_question_total",
        "phase4_gate_path",
        "phase4_gate_status",
        "delivery_lock_path",
        "offline_toolkit_manifest_path",
        "offline_toolkit_status",
        "binding_policy",
        "activation_policy"
      ],
      "properties": {
        "job_skill_runtime_authority_path": { "type": "string", "minLength": 1 },
        "job_skill_runtime_status": { "const": "DRAFT_COMPILED_NOT_ACTIVATABLE" },
        "job_skill_question_total": { "const": 298 },
        "phase4_gate_path": { "type": "string", "minLength": 1 },
        "phase4_gate_status": { "const": "BLOCKED_ASSET_DELIVERY_AND_PILOT_GATE" },
        "delivery_lock_path": { "type": "string", "minLength": 1 },
        "offline_toolkit_manifest_path": { "type": "string", "minLength": 1 },
        "offline_toolkit_status": { "const": "LOCKED_FOR_PRODUCTION" },
        "binding_policy": { "type": "string", "minLength": 1 },
        "activation_policy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "gateReview": {
      "type": "object",
      "required": ["required", "status", "reviewer_kind", "reviewer_name", "reviewed_at", "report_path", "notes"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["pending", "passed", "rejected", "waived", "revision_required"] },
        "reviewer_kind": { "enum": ["human", "script", "ai_advisory"] },
        "reviewer_name": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date" },
        "report_path": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": ["source_type", "license", "attribution_required", "source_reference", "commercial_use_cleared"],
      "properties": {
        "source_type": { "enum": ["ai_generated", "original", "licensed_library", "public_domain"] },
        "license": { "type": ["string", "null"] },
        "attribution_required": { "type": "boolean" },
        "source_reference": { "type": ["string", "null"] },
        "commercial_use_cleared": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "plan_key",
        "category",
        "priority",
        "description",
        "question_ids",
        "current_question_ids",
        "asset_type",
        "asset_role",
        "usage_mode",
        "delivery_format",
        "production_method",
        "review_level",
        "lifecycle_status",
        "complexity_level",
        "reference_pack",
        "reference_asset_ids",
        "prompt_template_id",
        "prompt_version",
        "prompt_text",
        "provider",
        "model",
        "route",
        "fallback_model",
        "fallback_route",
        "fallback_allowed_when",
        "fallback_used",
        "fallback_reason",
        "generation_params",
        "generation_date",
        "source_path",
        "runtime_path",
        "file_hash",
        "expected_answer",
        "answer_contract_hash",
        "production_contract",
        "text_handling",
        "construct",
        "target_cue",
        "distractors",
        "policy_basis",
        "forbidden_visual_cues",
        "required_overlay",
        "overlay_spec",
        "gate_reviews",
        "ai_pre_review",
        "rights",
        "qa_record_paths"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^asset_[a-z0-9_]+$",
          "description": "运行时稳定 ID，兼容 app://asset/<asset_id>"
        },
        "plan_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "visual-asset-master-plan.md 中的素材 ID"
        },
        "category": { "enum": ["A", "B", "C", "D", "E", "F", "G", "DELIVERY", "REFERENCE"] },
        "priority": { "enum": ["P0", "P1", "P2", "REFERENCE"] },
        "description": { "type": "string", "minLength": 1 },
        "question_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "current_question_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "asset_type": {
          "enum": [
            "product_photo",
            "scene",
            "damaged",
            "icon_svg",
            "aac_svg",
            "emotion_svg",
            "character",
            "video",
            "bg",
            "step_illustration",
            "avatar",
            "app_icon",
            "reference",
            "software_task",
            "tool_card",
            "process_strip"
            ,"answer_image"
            ,"role_play_script"
            ,"audio"
            ,"offline_setup_guide"
            ,"sealed_config"
          ]
        },
        "asset_role": { "enum": ["QUESTION_MEDIA", "UI_ASSET", "TOOL_CHECKLIST", "ROLE_PLAY_SCRIPT", "SEALED_ADMIN_CONFIG", "OFFLINE_SETUP_GUIDE", "OTHER"] },
        "usage_mode": { "enum": ["training", "assessment", "both", "system", "production"] },
        "delivery_format": { "enum": ["png", "webp", "svg", "css", "mp4", "mp3", "json", "pdf"] },
        "production_method": { "enum": ["ai_direct", "ai_plus_overlay", "programmatic", "composite", "authored"] },
        "review_level": { "enum": ["standard", "assessment_critical", "safety_critical"] },
        "lifecycle_status": { "enum": ["planned", "generated", "composited", "reviewing", "approved", "retired"] },
        "complexity_level": { "type": ["string", "null"], "enum": ["L0", "L1", "L2", "L3", null] },
        "reference_pack": { "enum": ["core", "extended"] },
        "reference_asset_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^asset_[a-z0-9_]+$" },
          "uniqueItems": true
        },
        "prompt_template_id": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "prompt_text": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"], "enum": ["apimart", "manual", "codegen", null] },
        "model": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] },
        "fallback_model": { "type": ["string", "null"] },
        "fallback_route": { "type": ["string", "null"] },
        "fallback_allowed_when": {
          "type": "array",
          "items": { "enum": ["primary_unavailable", "manual_override"] },
          "uniqueItems": true
        },
        "fallback_used": { "type": "boolean" },
        "fallback_reason": {
          "type": ["string", "null"],
          "enum": ["primary_unavailable", "manual_override", null]
        },
        "generation_params": {
          "type": ["object", "null"],
          "properties": {
            "size": { "type": ["string", "null"] },
            "resolution": { "type": ["string", "null"] },
            "n": { "type": ["integer", "null"], "minimum": 1, "maximum": 1 },
            "duration": { "type": ["integer", "null"], "minimum": 5, "maximum": 15 },
            "generate_audio": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        },
        "generation_date": { "type": ["string", "null"], "format": "date" },
        "source_path": { "type": ["string", "null"] },
        "runtime_path": { "type": ["string", "null"] },
        "file_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "width_px": { "type": ["integer", "null"], "minimum": 1 },
        "height_px": { "type": ["integer", "null"], "minimum": 1 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 1 },
        "expected_answer": {},
        "answer_contract_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "production_contract": { "type": ["object", "null"] },
        "text_handling": { "type": ["string", "null"], "enum": ["none", "ai_reviewed", "programmatic", "mixed", null] },
        "construct": { "type": ["string", "null"] },
        "target_cue": { "type": ["string", "null"] },
        "distractors": { "type": "array", "items": { "type": "string" } },
        "policy_basis": { "type": ["string", "null"] },
        "forbidden_visual_cues": { "type": "array", "items": { "type": "string" } },
        "required_overlay": { "type": "array", "items": { "type": "string" } },
        "overlay_spec": { "type": ["object", "null"] },
        "gate_reviews": {
          "type": "object",
          "required": ["technical", "visual", "vocational", "special_education", "assessment"],
          "properties": {
            "technical": { "$ref": "#/$defs/gateReview" },
            "visual": { "$ref": "#/$defs/gateReview" },
            "vocational": { "$ref": "#/$defs/gateReview" },
            "special_education": { "$ref": "#/$defs/gateReview" },
            "assessment": { "$ref": "#/$defs/gateReview" }
          },
          "additionalProperties": false
        },
        "ai_pre_review": { "type": ["object", "null"] },
        "rights": { "$ref": "#/$defs/rights" },
        "qa_record_paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "lifecycle_status": { "enum": ["generated", "composited", "reviewing", "approved"] } } },
          "then": { "required": ["source_path", "file_hash"] }
        },
        {
          "if": { "properties": { "lifecycle_status": { "const": "approved" } } },
          "then": { "required": ["runtime_path"] }
        }
      ]
    }
  }
}
