{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job Skill Shelver 298 Accepted Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "accepted_at",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "./job-skill-shelver-298-source-manifest-v1.schema.json"
    },
    "schema_version": {
      "const": "job-skill-shelver-298-source-manifest-v1"
    },
    "manifest_id": {
      "const": "job-skill-shelver-298-source-manifest-v1"
    },
    "status": {
      "const": "ACCEPTED_INPUT_HASHES"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "sha256", "role", "immutable"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "role": {
            "enum": [
              "SOURCE_SNAPSHOT",
              "REVIEW_SCOPE_PACKET",
              "FIRST_REVIEW_ORIGINAL",
              "CONFLICT_RESOLUTION_ORIGINAL",
              "PILOT_CURRENT_CANDIDATE",
              "PILOT_ACTIVATION_GATE",
              "REREVIEW_ORIGINAL"
            ]
          },
          "immutable": { "const": true }
        }
      }
    }
  }
}
