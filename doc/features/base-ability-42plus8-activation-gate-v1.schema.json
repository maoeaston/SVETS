{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base-ability-42plus8-activation-gate-v1.schema.json",
  "title": "BASE_ABILITY 42+8 Activation Gate",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "gate_id",
    "status",
    "generated_at",
    "authority",
    "summary",
    "gates",
    "activation_authority_granted",
    "activation_policy"
  ],
  "properties": {
    "$schema": { "const": "./base-ability-42plus8-activation-gate-v1.schema.json" },
    "schema_version": { "const": "base-ability-42plus8-activation-gate-v1" },
    "gate_id": { "type": "string", "minLength": 1 },
    "status": { "const": "BLOCKED_DRAFT_REVIEW_RENDERER_MATERIAL_AND_TRIAL_GATE" },
    "generated_at": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "required": [
        "product_contract_path",
        "source_path",
        "source_sha256",
        "import_sql_path",
        "import_sql_sha256",
        "content_pack_path"
      ],
      "additionalProperties": false,
      "properties": {
        "product_contract_path": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "import_sql_path": { "type": "string", "minLength": 1 },
        "import_sql_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "content_pack_path": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "source_question_total",
        "draft_total",
        "active_total",
        "online_candidate_total",
        "offline_candidate_total",
        "observation_only_total",
        "no_score_total",
        "media_asset_bound_total",
        "tool_asset_bound_total",
        "question_type_counts",
        "status_counts",
        "modules"
      ],
      "properties": {
        "source_question_total": { "const": 96 },
        "draft_total": { "type": "integer", "minimum": 0 },
        "active_total": { "type": "integer", "minimum": 0 },
        "online_candidate_total": { "const": 87 },
        "offline_candidate_total": { "const": 8 },
        "observation_only_total": { "const": 1 },
        "no_score_total": { "type": "integer", "minimum": 0 },
        "media_asset_bound_total": { "type": "integer", "minimum": 0 },
        "tool_asset_bound_total": { "type": "integer", "minimum": 0 },
        "question_type_counts": { "type": "object" },
        "status_counts": { "type": "object" },
        "modules": { "type": "object" }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "status", "details"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASSED", "FAILED", "BLOCKED", "PENDING"] },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "activation_authority_granted": { "const": false },
    "activation_policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
